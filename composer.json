{
    "name": "heyosseus/sloppy",
    "description": "Static analysis for the debt AI coding agents leave behind, on any PHP project: 25 rules, git-diff review, coverage-aware reading order, PHPStan baseline-growth detection, a Rector and Pint fix pass, Pest expectations, CI annotations, agent rulesets and an MCP server. Extra rules and dashboards for Laravel. Deterministic, local, no LLM.",
    "keywords": [
        "php",
        "static-analysis",
        "code-quality",
        "ai",
        "slop",
        "technical-debt",
        "laravel",
        "mcp",
        "rector",
        "pest",
        "pint",
        "filament",
        "ai-agents",
        "code-review",
        "ci"
    ],
    "license": "MIT",
    "homepage": "https://github.com/heyosseus/sloppy",
    "support": {
        "issues": "https://github.com/heyosseus/sloppy/issues",
        "source": "https://github.com/heyosseus/sloppy"
    },
    "authors": [
        {
            "name": "heyosseus",
            "email": "ratiruxadzee@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "nikic/php-parser": "^5.3",
        "symfony/console": "^7.0 || ^8.0",
        "symfony/finder": "^7.0 || ^8.0",
        "symfony/process": "^7.0 || ^8.0"
    },
    "require-dev": {
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.7 || ^4.0",
        "pestphp/pest-plugin-laravel": "^3.1 || ^4.0",
        "pestphp/pest-plugin-type-coverage": "^3.2 || ^4.0",
        "rector/rector": "^2.0"
    },
    "bin": [
        "bin/sloppy",
        "bin/sloppy-mcp"
    ],
    "suggest": {
        "illuminate/console": "Required for the php artisan sloppy commands. Not needed for the standalone bin/sloppy binary.",
        "rector/rector": "Required by sloppy fix, which hands the fixable findings to Rector.",
        "laravel/pint": "Used by sloppy fix to format the files Rector rewrote.",
        "filament/filament": "Required for the Filament panel plugin and health widget.",
        "pestphp/pest": "Required for the expectCleanSloppyDiff() test expectation.",
        "ext-xml": "Used to read clover and cobertura coverage reports, which raise untested changed files in the review order. Without it coverage is skipped and nothing else changes."
    },
    "autoload": {
        "psr-4": {
            "Heyosseus\\Sloppy\\": "src/"
        },
        "files": [
            "pest/Expectations.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Heyosseus\\Sloppy\\Tests\\": "tests/"
        },
        "classmap": [
            "tests/Stubs"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "process-timeout": 600,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Heyosseus\\Sloppy\\SloppyServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refacto": "rector",
        "test:lint": "pint --test",
        "test:refacto": "rector --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=512M",
        "test:type-coverage": "pest --type-coverage --min=100",
        "test:unit": "pest --colors=always --coverage --min=99",
        "test": [
            "@test:refacto",
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ]
    }
}
