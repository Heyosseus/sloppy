#!/usr/bin/env php
<?php

declare(strict_types=1);

use Heyosseus\Sloppy\Cli\SloppyApplication;
use Heyosseus\Sloppy\Sloppy;

foreach ([
    // Installed as a dependency of the analysed project.
    __DIR__.'/../../../autoload.php',
    // Running from a clone of the package itself.
    __DIR__.'/../vendor/autoload.php',
] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

if (! class_exists(SloppyApplication::class)) {
    fwrite(STDERR, "Composer autoloader not found. Run `composer install` first.\n");

    exit(2);
}

// `sloppy hook` and `sloppy mcp` read from standard input. Symfony measures
// the terminal before any command runs, and on Windows it does that by running
// `mode CON` -- which inherits standard input and swallows a redirected file
// before the command can read it. A width already in the environment skips the
// measurement, and nothing either command prints depends on one.
if (in_array($argv[1] ?? null, ['hook', 'mcp'], true)) {
    foreach (['COLUMNS' => '80', 'LINES' => '50'] as $name => $default) {
        if (getenv($name) === false) {
            putenv($name.'='.$default);
        }
    }
}

exit((new SloppyApplication(Sloppy::VERSION))->run());
